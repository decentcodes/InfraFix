# InfraFix root rules (Apache).
Options -Indexes

# Never serve source-control, SQL, docs, logs or backup files.
<FilesMatch "\.(sql|md|log|bak|ini|example\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
